import { Component, Input, Output, EventEmitter, TemplateRef } from '@angular/core';
import { CommonModule } from '@angular/common';
import { MatIconModule } from '@angular/material/icon';
import { MatButtonModule } from '@angular/material/button';
import { FormsModule } from '@angular/forms';
import { ScrollingModule } from '@angular/cdk/scrolling';

@Component({
  selector: 'app-entity-sidebar-list',
  standalone: true,
  imports: [CommonModule, MatIconModule, MatButtonModule, FormsModule, ScrollingModule],
  templateUrl: './entity-sidebar-list.component.html',
  styleUrls: ['./entity-sidebar-list.component.scss']
})
export class EntitySidebarListComponent {
  @Input() isCollapsed: boolean = false;
  @Output() isCollapsedChange = new EventEmitter<boolean>();

  @Input() items: any[] = [];
  @Input() itemTemplate!: TemplateRef<any>;
  @Input() itemSize: number = 72; // default height for virtual scrolling
  
  @Input() searchPlaceholder: string = 'Search...';
  @Input() emptyMessage: string = 'No items found.';
  
  // Default header props if not using custom projection
  @Input() headerTitle: string = 'AAD';
  @Input() headerIcon: string = 'build';

  @Output() searchChange = new EventEmitter<string>();

  searchQuery: string = '';

  toggleSidebar() {
    this.isCollapsed = !this.isCollapsed;
    this.isCollapsedChange.emit(this.isCollapsed);
  }

  trackById(index: number, item: any): any {
    return item.id || index;
  }

  onSearchChange() {
    this.searchChange.emit(this.searchQuery);
  }
}
